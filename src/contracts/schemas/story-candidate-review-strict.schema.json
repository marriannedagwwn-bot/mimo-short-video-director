{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "internal://story-candidate-review-strict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceMechanisms",
    "candidateChecks",
    "recommendedOrder",
    "summary"
  ],
  "properties": {
    "schemaVersion": { "const": "story-candidate-review/1.0" },
    "sourceMechanisms": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/sourceMechanism" }
    },
    "candidateChecks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/candidateCheck" }
    },
    "recommendedOrder": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "summary": { "$ref": "#/$defs/nonEmptyString" }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "pattern": "\\S"
    },
    "verdict": {
      "enum": ["depicted", "partially_depicted", "not_depicted"]
    },
    "candidateVerdict": {
      "enum": ["pass", "revise", "drop"]
    },
    "coreInteraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["setback", "intervention", "response", "visibleChange"],
      "properties": {
        "setback": { "$ref": "#/$defs/nonEmptyString" },
        "intervention": { "$ref": "#/$defs/nonEmptyString" },
        "response": { "$ref": "#/$defs/nonEmptyString" },
        "visibleChange": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "sourceMechanism": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mechanism", "whereInSource", "requiresCause"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "mechanism": { "$ref": "#/$defs/nonEmptyString" },
        "whereInSource": { "$ref": "#/$defs/nonEmptyString" },
        "requiresCause": { "type": "boolean" }
      }
    },
    "mechanismCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceMechanismId", "causeEvidence", "actionEvidence", "beatIndexes", "verdict"],
      "properties": {
        "sourceMechanismId": { "$ref": "#/$defs/nonEmptyString" },
        "causeEvidence": { "type": "string" },
        "actionEvidence": { "$ref": "#/$defs/nonEmptyString" },
        "beatIndexes": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 }
        },
        "verdict": { "$ref": "#/$defs/verdict" }
      }
    },
    "coherenceCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "beatIndexes", "problem"],
      "properties": {
        "kind": { "enum": ["contradiction", "tool_misuse", "purpose_nullified", "space_or_time", "other"] },
        "beatIndexes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1 }
        },
        "problem": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "scaffoldLinkage": {
      "enum": ["same", "reordered", "different", "absent"]
    },
    "scaffoldDimension": {
      "enum": ["same", "partial", "different", "not_applicable"]
    },
    "scaffoldEventLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceEvent", "candidateEvent", "beatIndexes", "linkage"],
      "properties": {
        "sourceEvent": { "$ref": "#/$defs/nonEmptyString" },
        "candidateEvent": { "type": "string" },
        "beatIndexes": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 }
        },
        "linkage": { "$ref": "#/$defs/scaffoldLinkage" }
      }
    },
    "sourceScaffoldOverlap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventChain",
        "taskType",
        "midSection",
        "rewardSource",
        "rewardHandling",
        "endingShape",
        "score",
        "why"
      ],
      "properties": {
        "eventChain": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/scaffoldEventLink" }
        },
        "taskType": { "$ref": "#/$defs/scaffoldDimension" },
        "midSection": { "$ref": "#/$defs/scaffoldDimension" },
        "rewardSource": { "$ref": "#/$defs/scaffoldDimension" },
        "rewardHandling": { "$ref": "#/$defs/scaffoldDimension" },
        "endingShape": { "$ref": "#/$defs/scaffoldDimension" },
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "why": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "candidateCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "title",
        "coreInteraction",
        "mechanismChecks",
        "coherenceChecks",
        "sourceScaffoldOverlap",
        "verdict",
        "why",
        "keepThis"
      ],
      "properties": {
        "candidateId": { "$ref": "#/$defs/nonEmptyString" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "coreInteraction": { "$ref": "#/$defs/coreInteraction" },
        "mechanismChecks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/mechanismCheck" }
        },
        "coherenceChecks": {
          "type": "array",
          "items": { "$ref": "#/$defs/coherenceCheck" }
        },
        "sourceScaffoldOverlap": { "$ref": "#/$defs/sourceScaffoldOverlap" },
        "verdict": { "$ref": "#/$defs/candidateVerdict" },
        "why": { "$ref": "#/$defs/nonEmptyString" },
        "keepThis": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  }
}
